# Copy this file to .env and adjust as needed.
# Never commit a real .env file with secrets.

# ---- Backend ----
ENVIRONMENT=development

# Default: local SQLite file, zero external setup required.
DATABASE_URL=sqlite:///./data/prism.db
# To use PostgreSQL instead (e.g. via docker-compose), set the local values below:
# DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@localhost:5432/<db-name>

# Docker Compose placeholders; replace locally and keep the real .env uncommitted.
POSTGRES_USER=prism_user
POSTGRES_PASSWORD=<set-local-password>
POSTGRES_DB=prism

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reserved for a future natural-language search/explanation layer.
# Not currently read by any code path — plain substring search
# (app/api/search.py) works fully without it.
ANTHROPIC_API_KEY=

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api
